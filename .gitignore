# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/
.venv/

# Distribution / packaging
build/
dist/
*.egg-info/

# Environment (secrets). The .env.example files are committed.
.env
frontend/.env.local
frontend/.env*local

# Local data generated
dataset/*

# Next.js
frontend/node_modules/
frontend/.next/

# Runtime storage. Records, logs, audit, checkpoints and model caches live in MySQL;
# only uploaded scans, policy PDFs, the Qdrant vector store and evaluation reports are files.
backend/storage/uploads/*
backend/storage/policies/*
backend/storage/qdrant/
backend/storage/dataset_run/

# Logs are written to MySQL (table app_log); never commit a stray log file
*.log

# IDE
.vscode/
.idea/

# OS
.DS_Store
