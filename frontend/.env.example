# Frontend settings (Next.js). NEXT_PUBLIC_* values are built into the browser bundle: rebuild after changing them.
API_URL=http://127.0.0.1:8000
RECENT_UPLOADS=5
NEXT_PUBLIC_REFRESH_MS=2500
NEXT_PUBLIC_MAX_UPLOAD_MB=20
NEXT_PUBLIC_MAX_BATCH_FILES=25
NEXT_PUBLIC_UPLOAD_EXTENSIONS=.jpg,.jpeg,.png,.pdf,.tif,.tiff
NEXT_PUBLIC_SINGLE_UPLOAD_EXTENSIONS=.png,.jpg,.jpeg,.tif,.tiff,.bmp
