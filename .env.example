# Copy to .env and fill in the <set me> values. Every key is read by backend/app/config.py.
# .env
GROQ_API_KEY=<set me>
GEMINI_API_KEY=<set me>
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
MODEL_NAME=qwen/qwen3.8-27b
VISION_MODEL_NAME=qwen/qwen3.8-27b
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPARSE_MODEL=Qdrant/bm25
COLLECTION_NAME=policy_agent_collection
STORAGE_PATH = /tmp/my_lang_vs
ADMIN_PASSWORD=<set me>
AGENT_PASSWORD=<set me>

# Local testing: Ollama. Switch LLM_PROVIDER to groq for the hosted setup.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL_NAME=gemma3:4b
OLLAMA_VISION_MODEL_NAME=gemma3:4b

# ---- Runtime settings: read by backend/app/config.py (no values are set in code) ----
# MySQL holds every record: members, claims, pages, decisions, audit log, LangGraph checkpoints, model caches
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=<set me>
MYSQL_DB=medishield
MYSQL_CONNECT_TIMEOUT_S=5

# Models (LLM_PROVIDER, model names and OLLAMA_HOST are above)
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT_S=900
OLLAMA_MAX_TOKENS_TEXT=2048
OLLAMA_MAX_TOKENS_VISION=4096
LLM_RETRY_ATTEMPTS=3
LLM_MAX_RATE_LIMIT_WAIT_S=90
VISION_MAX_SIDE=1280
VISION_JPEG_QUALITY=85

# Files (relative to the project root)
DATASET_DIR=dataset
STORAGE_DIR=backend/storage
UPLOAD_DIR=backend/storage/uploads
POLICY_PDF_DIR=backend/storage/policies
QDRANT_PATH=backend/storage/qdrant
PIPELINE_RULES=backend/pipeline_rules.json

# Uploads and API
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=30
PDF_RENDER_DPI=150
UPLOAD_EXTENSIONS=.jpg,.jpeg,.png,.pdf,.tif,.tiff
SINGLE_UPLOAD_EXTENSIONS=.png,.jpg,.jpeg,.tif,.tiff,.bmp
MAX_BATCH_FILES=25
MAX_CLAIM_PAGES=60
LIST_LIMIT_DEFAULT=200
LIST_LIMIT_MAX=500
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PIPELINE_WORKERS=1

# Auth
JWT_SECRET=<set me>
JWT_TTL_HOURS=8
PASSWORD_HASH_ITERATIONS=210000

# Policy retrieval and assistant
POLICY_MAX_CLAUSE_CHARS=1800
POLICY_CHUNK_TOKENS=256
POLICY_CHAT_MAX_HISTORY_TURNS=8
POLICY_CHAT_MAX_CLAUSE_CHARS=1200
POLICY_CHAT_MAX_SOURCES=4

# Single-document pipeline thresholds (the claim pipeline reads PIPELINE_RULES)
AGENT_CONFIDENCE_MIN=0.6
FRAUD_ESCALATE_MIN=0.3
BLUR_VARIANCE_MIN=100

# Scripts
API_URL=http://127.0.0.1:8000
DATASET_RUN_TIMEOUT_S=3600

# Logs: written to MySQL (table app_log), not to files
LOG_LEVEL=INFO
LOG_BATCH_SIZE=50
LOG_FLUSH_S=2
LOG_EXPORT_MAX_ROWS=100000
LOG_STATS_SCAN_MAX=50000
LOG_TOP_N=10
